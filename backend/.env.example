# ============================================================
# Backend environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# Django
DJANGO_SECRET_KEY=your-super-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=ai_breastcancer_db
DB_USER=postgres
DB_PASSWORD=sql@321
DB_HOST=localhost
DB_PORT=5432

# Frontend origin allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Active ML model configuration (optional - overrides backend/ml/config.py)
# ML_MODEL_FILE may be either a bare filename stored in backend/ml/model/
# (e.g. CancerNet_Model.h5) or an absolute path to a .h5 anywhere on disk.
# ML_MODEL_NAME=CancerNet
# ML_MODEL_FILE=CancerNet_Model.h5
# ML_IMAGE_SIZE=50
# ML_DATASET_NAME=IDC_regular_ps50_idx5
# ML_CLASSES=2
